# Copy to /opt/iphonefixit/backend.env on EC2 and replace every placeholder.
# Raw env_file: values are literal. Do not surround them with quotes.
DB_HOST=YOUR_AIVEN_HOST
DB_PORT=YOUR_AIVEN_PORT
DB_NAME=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=REPLACE_ME
DB_SSL_MODE=REQUIRED
FRONTEND_URL=http://YOUR_EC2_PUBLIC_IP
BACKEND_URL=http://YOUR_EC2_PUBLIC_IP
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
ADMIN_NAME=iPhoneFixit Admin
ADMIN_EMAIL=YOUR_ADMIN_EMAIL
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=65.0
